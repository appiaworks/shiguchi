{
  "type": "record",
  "namespace": "com.acme.inventory",
  "name": "Item",
  "fields": [
    {
      "name": "sku",
      "type": "string"
    },
    {
      "name": "name",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "qty",
      "type": "long"
    },
    {
      "name": "price",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 10,
        "scale": 2
      }
    },
    {
      "name": "tags",
      "type": {
        "type": "array",
        "items": "string"
      }
    },
    {
      "name": "attrs",
      "type": {
        "type": "map",
        "values": "string"
      }
    },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "ItemStatus",
        "symbols": ["ACTIVE", "RETIRED"]
      }
    },
    {
      "name": "updatedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "created",
      "type": {
        "type": "int",
        "logicalType": "date"
      }
    },
    {
      "name": "category",
      "type": [
        "null",
        {
          "type": "record",
          "name": "Category",
          "fields": [
            {
              "name": "id",
              "type": "int"
            },
            {
              "name": "name",
              "type": "string"
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "fixedId",
      "type": {
        "type": "fixed",
        "size": 4,
        "name": "Id4"
      }
    }
  ]
}
