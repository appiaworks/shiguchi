{
  "openapi": "3.0.3",
  "info": {
    "title": "Inventory API with Avro",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://inventory:8080",
      "description": "Inventory backend"
    }
  ],
  "paths": {
    "/items/{sku}": {
      "get": {
        "operationId": "getItem",
        "summary": "Get an item by SKU",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "Avro/Binary; charset=x": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      }
    },
    "/items": {
      "get": {
        "operationId": "listItems",
        "summary": "List all items",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createItem",
        "summary": "Create a new item",
        "requestBody": {
          "content": {
            "avro/binary": {
              "schema": {
                "$ref": "#/components/schemas/Item"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Item"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Get system status",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "integer"
          }
        },
        "required": ["sku", "qty"],
        "x-avro-schema": {
          "type": "record",
          "namespace": "com.acme.inventory",
          "name": "Item",
          "fields": [
            {
              "name": "sku",
              "type": "string"
            },
            {
              "name": "name",
              "type": ["null", "string"],
              "default": null
            },
            {
              "name": "qty",
              "type": "long"
            }
          ]
        }
      }
    }
  }
}
