{
  "name": "@appiaworks/shiguchi-cursus-client",
  "version": "0.14.0",
  "description": "Experimental client for the Cursus (Shiguchi push) WebSocket protocol: reconnect, resume from the last id, token refresh and gap reporting.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appiaworks/shiguchi.git",
    "directory": "shiguchi-cursus-client-js"
  },
  "homepage": "https://github.com/appiaworks/shiguchi/tree/main/shiguchi-cursus-client-js#readme",
  "bugs": "https://github.com/appiaworks/shiguchi/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxlint": "^1.86.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
